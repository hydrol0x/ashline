# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- CoStar track keys: run /costar-keys in #costar-group on the HackPrinceton Discord ---
MATTERPORT_API_KEY=        # Matterport "API key"  (basic-auth user name)
MATTERPORT_API_TOKEN=      # Matterport "API token" (basic-auth password)
VEXCEL_API_KEY=            # Vexcel long-life key (X-API-KEY header)

# Optional: CoStar listing join (listing_record). Give either the link or a local zip path.
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=
COSTAR_ZIP_PASSWORD=       # type it by hand; pasting has failed for other teams

# --- Item detection ---
# ASHLINE_DETECTOR = claude | vlm | florence. Left empty it picks claude when ANTHROPIC_API_KEY is
# set, else vlm when ASHLINE_VLM_API_KEY is set, else florence (local model, no key, slower).
ASHLINE_DETECTOR=

# claude: your Anthropic API credits, through the Anthropic SDK
ANTHROPIC_API_KEY=
ASHLINE_CLAUDE_MODEL=claude-opus-5-5
ASHLINE_CLAUDE_EFFORT=medium

# vlm: any OpenAI-compatible chat endpoint (OpenRouter, a gateway, ...)
ASHLINE_VLM_BASE_URL=https://openrouter.ai/api/v1
ASHLINE_VLM_API_KEY=
ASHLINE_VLM_MODEL=anthropic/claude-sonnet-5.5

# --- Agent model for the deepagents orchestrator (langchain init_chat_model string) ---
# "anthropic:..." uses ANTHROPIC_API_KEY above.
ASHLINE_AGENT_MODEL=anthropic:claude-opus-5-5

# --- Demo home: keep the real scan id and address out of the repo, set one of them here only ---
ASHLINE_DEMO_SID=          # scan id (the sid column of models_index.csv)
ASHLINE_DEMO_ADDRESS=      # or the address; put it in "quotes" if it contains a #
ASHLINE_LOSS_DATE=2025-01-07   # aerial imagery is taken from the last flight before this date

# Where case data is written (git-ignored)
ASHLINE_DATA_DIR=cases
