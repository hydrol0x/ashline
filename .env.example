# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- CoStar track keys: run /costar-keys in #costar-group on the HackPrinceton Discord ---
MATTERPORT_API_KEY=        # Matterport "API key"  (basic-auth user name)
MATTERPORT_API_TOKEN=      # Matterport "API token" (basic-auth password)
VEXCEL_API_KEY=            # Vexcel long-life key (X-API-KEY header)

# Optional: CoStar listing join (listing_record). Give either the link or a local zip path.
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=
COSTAR_ZIP_PASSWORD=       # type it by hand; pasting has failed for other teams

# --- Item detection ---
# ASHLINE_DETECTOR = claude | vlm | florence. Left empty it picks claude when ANTHROPIC_API_KEY is
# set, else vlm when ASHLINE_VLM_API_KEY is set, else florence (local model, no key, slower).
ASHLINE_DETECTOR=

# claude: your Anthropic API credits, through the Anthropic SDK
ANTHROPIC_API_KEY=
ASHLINE_CLAUDE_MODEL=claude-opus-5-5
ASHLINE_CLAUDE_EFFORT=medium

# Merging repeats of the same object across panoramas: ASHLINE_MERGER = claude | rules.
# Left empty it uses claude when ANTHROPIC_API_KEY is set (one small text request per room).
ASHLINE_MERGER=

# vlm: any OpenAI-compatible chat endpoint (OpenRouter, a gateway, ...)
ASHLINE_VLM_BASE_URL=https://openrouter.ai/api/v1
ASHLINE_VLM_API_KEY=
ASHLINE_VLM_MODEL=anthropic/claude-sonnet-5.5

# --- Agent model for the deepagents orchestrator (langchain init_chat_model string) ---
# "anthropic:..." uses ANTHROPIC_API_KEY above.
ASHLINE_AGENT_MODEL=anthropic:claude-opus-5-5

# Messages that match no exact command are understood by Claude and mapped to a real command.
# ASHLINE_INTERPRETER=off turns it off. A small fast model is enough.
ASHLINE_INTENT_MODEL=claude-haiku-5-5

# Prices: ASHLINE_PRICER = claude | defaults. Left empty it uses claude when ANTHROPIC_API_KEY is set.
ASHLINE_PRICER=

# --- Photon 2.0 (iMessage): `ashline photon` ---
PHOTON_API_KEY=            # project API key, pho_sk_...
PHOTON_PROJECT_ID=         # pho_prj_...

# --- Conversation and inventory page ---
ASHLINE_PUBLIC_URL=        # public address of the worker (your tunnel), used in links sent to the family
ASHLINE_NUMBER=            # the phone number families text, shown in the invite message
ASHLINE_BATCH_SECONDS=60   # quiet time after the last photo of a burst before the digest
ASHLINE_VIDEO_FRAMES=14    # stills taken from one video (needs the ffmpeg program installed)
ASHLINE_SKETCHER=auto      # plan of a home with no scan: auto = drawn by Claude from the photos when a key is set; rules = boxes only
ASHLINE_BRIDGE_URL=        # the messaging bridge; when set, digests and reviews are posted to <url>/outbound
ASHLINE_INBOUND_SECRET=    # if set, /inbound and /tick require it in the X-Ashline-Secret header

# --- Demo home: keep the real scan id and address out of the repo, set one of them here only ---
ASHLINE_DEMO_SID=          # scan id (the sid column of models_index.csv)
ASHLINE_DEMO_ADDRESS=      # or the address; put it in "quotes" if it contains a #
ASHLINE_LOSS_DATE=2025-01-07   # aerial imagery is taken from the last flight before this date

# Where case data is written (git-ignored)
ASHLINE_DATA_DIR=cases

# Telegram (optional): run `ashline telegram` next to `ashline photon` so families can use a group chat.
# Get a token from @BotFather (/newbot), and send it /setprivacy -> Disable so the bot sees group photos.
TELEGRAM_BOT_TOKEN=
# Only if your network blocks Telegram: a Cloudflare Worker relay (worker/relay/telegram-relay.js).
TELEGRAM_API_BASE=
# Bank records (Capital One Nessie, the hackathon's mock bank): match card purchases to items.
NESSIE_API_KEY=            # free key from http://api.nessieisreal.com
NESSIE_CUSTOMER_ID=        # optional: read only this customer's accounts
NESSIE_ACCOUNT_ID=         # optional: read only this account (printed by `ashline bank --seed-demo`)
